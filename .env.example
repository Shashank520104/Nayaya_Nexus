# NyayaNexus – Environment Configuration
# Contributors: Shashank, Shubh, Ashutosh

PORT=3000
NODE_ENV=development

# Google Gemini API Key (Optional: NyayaNexus has a built-in Grounded Legal Engine fallback that works 100% offline)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
