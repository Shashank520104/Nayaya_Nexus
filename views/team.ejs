  <!-- MVC Architecture Breakdown -->
  <section class="section mvc-architecture-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Software Engineering</span>
        <h2 class="section-title">MVC Architecture & Separation of Concerns</h2>
        <p class="section-desc">
          NyayaNexus follows a strictly humanized, modular codebase with zero bloated monolithic files.
        </p>
      </div>

      <div class="mvc-grid">
        <!-- Model -->
        <div class="mvc-card">
          <div class="mvc-card-header">
            <div class="mvc-pill pill-model">Model Layer</div>
            <h3><code>/models</code></h3>
          </div>
          <p>Encapsulates data structures, domain logic, and validation.</p>
          <ul class="mvc-file-list">
            <li><code>schemeModel.js</code>: Welfare database & eligibility engine</li>
            <li><code>legalModel.js</code>: BNS 2023 & IPC statutory repository</li>
            <li><code>promptModel.js</code>: System prompt templates & benchmarks</li>
            <li><code>draftModel.js</code>: RTI & legal notice formats</li>
            <li><code>chatSessionModel.js</code>: Thread history & prompt traces</li>
          </ul>
        </div>

        <!-- View -->
        <div class="mvc-card">
          <div class="mvc-card-header">
            <div class="mvc-pill pill-view">View Layer</div>
            <h3><code>/views</code></h3>
          </div>
          <p>Semantic EJS templates and modular frontend components.</p>
          <ul class="mvc-file-list">
            <li><code>index.ejs</code>: Public citizen empowerment landing page</li>
            <li><code>chat.ejs</code>: Multilingual AI chat interface with voice</li>
            <li><code>schemes.ejs</code>: Schemes finder & eligibility wizard</li>
            <li><code>legal-guide.ejs</code>: BNS vs IPC side-by-side transition</li>
            <li><code>draft-generator.ejs</code>: RTI & legal notice live maker</li>
            <li><code>prompt-studio.ejs</code>: Prompt refinement laboratory</li>
          </ul>
        </div>

        <!-- Controller -->
        <div class="mvc-card">
          <div class="mvc-card-header">
            <div class="mvc-pill pill-controller">Controller Layer</div>
            <h3><code>/controllers</code></h3>
          </div>
          <p>Receives user input, coordinates models & services, sends view/JSON.</p>
          <ul class="mvc-file-list">
            <li><code>chatController.js</code>: Manages queries & context snapshots</li>
            <li><code>schemeController.js</code>: Handles search & eligibility calls</li>
            <li><code>legalController.js</code>: Delivers BNS explorer & helplines</li>
            <li><code>draftController.js</code>: Generates RTI & notice documents</li>
            <li><code>promptStudioController.js</code>: Runs raw vs refined tests</li>
            <li><code>teamController.js</code>: Renders team portfolio</li>
          </ul>
        </div>

        <!-- Services -->
        <div class="mvc-card">
          <div class="mvc-card-header">
            <div class="mvc-pill pill-service">Services Layer</div>
            <h3><code>/services</code></h3>
          </div>
          <p>Reusable business logic, AI calling, and prompt pipelines.</p>
          <ul class="mvc-file-list">
            <li><code>promptEngine.js</code>: Language detection & context injection</li>
            <li><code>geminiService.js</code>: Google Gemini API integration</li>
            <li><code>legalGroundingService.js</code>: Deterministic legal fallback</li>
            <li><code>schemeMatchingService.js</code>: Demographic score calculation</li>
            <li><code>draftGeneratorService.js</code>: Legal document text compiler</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
