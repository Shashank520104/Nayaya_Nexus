<%- include('partials/head', { title: 'Legal Notice & RTI Draft Generator – NyayaNexus' }) %>
<%- include('partials/navbar') %>

<main class="drafts-page-main">
  <!-- Top Hero Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-badge">
        <i class="fa-solid fa-file-contract"></i> Legal Documentation & Grievance Drafting
      </div>
      <h1 class="page-title">Citizen Legal Notice & RTI Draft Generator</h1>
      <p class="page-subtitle">
        Generate legally compliant RTI applications, consumer grievance notices, cheque dishonour demand letters, and formal police complaints in minutes.
      </p>

      <!-- Template Selector Tabs -->
      <div class="draft-tabs-nav">
        <% draftTypes.forEach(type => { %>
          <a 
            href="/drafts?type=<%= type.id %>" 
            class="draft-tab <%= selectedType === type.id ? 'active' : '' %>"
          >
            <i class="fa-solid fa-file-lines"></i>
            <span><%= type.name %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Split Screen Workspace: Form on Left, Live Preview on Right -->
  <section class="section draft-workspace-section">
    <div class="container draft-workspace-grid">
      <!-- Left Column: Input Form -->
      <div class="draft-form-card">
        <div class="card-header-clean">
          <div class="header-icon-title">
            <i class="fa-solid fa-pen-to-square"></i>
            <div>
              <h3>Fill Template Parameters</h3>
              <p class="sub-text"><%= currentTypeObj.description %></p>
            </div>
          </div>
        </div>

        <form id="draftForm" class="interactive-draft-form" data-type="<%= selectedType %>">
          <!-- RTI Form Fields -->
          <% if (selectedType === 'rti-application') { %>
            <div class="form-group">
              <label for="applicantName">Your Full Name *</label>
              <input type="text" id="applicantName" name="applicantName" placeholder="e.g. Ramesh Kumar Verma" required>
            </div>

            <div class="form-group">
              <label for="applicantAddress">Your Complete Postal Address *</label>
              <textarea id="applicantAddress" name="applicantAddress" rows="2" placeholder="House No, Street, Locality, District, State, PIN Code" required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="applicantPhone">Mobile Phone *</label>
                <input type="tel" id="applicantPhone" name="applicantPhone" placeholder="e.g. 9876543210" required>
              </div>
              <div class="form-group col-half">
                <label for="applicantEmail">Email Address</label>
                <input type="email" id="applicantEmail" name="applicantEmail" placeholder="e.g. ramesh@example.com">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="pioDesignation">Designation of Officer</label>
                <input type="text" id="pioDesignation" name="pioDesignation" value="The Public Information Officer (PIO)">
              </div>
              <div class="form-group col-half">
                <label for="publicAuthority">Public Department / Authority *</label>
                <input type="text" id="publicAuthority" name="publicAuthority" placeholder="e.g. Municipal Corporation, PWD, Health Dept" required>
              </div>
            </div>

            <div class="form-group">
              <label for="officeAddress">Office Address of Public Authority</label>
              <input type="text" id="officeAddress" name="officeAddress" placeholder="e.g. Town Hall, Civil Lines, Jaipur, Rajasthan">
            </div>

            <div class="form-group">
              <label for="subjectMatter">Subject Matter of Information</label>
              <input type="text" id="subjectMatter" name="subjectMatter" placeholder="e.g. Status of road repair budget allocation for Ward No. 12">
            </div>

            <div class="form-group">
              <label for="particularsOfInfo">Specific Questions / Documents Required (One per line) *</label>
              <textarea id="particularsOfInfo" name="particularsOfInfo" rows="4" placeholder="1. Certified copy of tender sanction order&#10;2. Total expenditure incurred till date&#10;3. Name of contractor and scheduled completion date" required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="periodOfInfo">Period of Information</label>
                <input type="text" id="periodOfInfo" name="periodOfInfo" placeholder="e.g. April 2024 to March 2025">
              </div>
              <div class="form-group col-half">
                <label for="bplStatus">Do you belong to BPL category?</label>
                <select id="bplStatus" name="bplStatus">
                  <option value="no">No (₹10 application fee applicable)</option>
                  <option value="yes">Yes (Fee exempt under Sec 7(5))</option>
                </select>
              </div>
            </div>
          <% } %>

          <!-- Consumer Notice Form Fields -->
          <% if (selectedType === 'consumer-notice') { %>
            <div class="form-group">
              <label for="senderName">Your Full Name (Consumer) *</label>
              <input type="text" id="senderName" name="senderName" placeholder="e.g. Priya Sharma" required>
            </div>

            <div class="form-group">
              <label for="senderAddress">Your Address & Contact Info *</label>
              <textarea id="senderAddress" name="senderAddress" rows="2" placeholder="Full postal address with PIN and phone number" required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="opponentName">Opponent Company / Retailer Name *</label>
                <input type="text" id="opponentName" name="opponentName" placeholder="e.g. XYZ Electronics Pvt Ltd / ABC E-Commerce" required>
              </div>
              <div class="form-group col-half">
                <label for="opponentEmail">Opponent Email / Grievance Desk</label>
                <input type="email" id="opponentEmail" name="opponentEmail" placeholder="e.g. grievance@company.com">
              </div>
            </div>

            <div class="form-group">
              <label for="opponentAddress">Company Registered Address</label>
              <input type="text" id="opponentAddress" name="opponentAddress" placeholder="e.g. Corporate Office, Cyber City, Gurugram, Haryana">
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="productName">Product / Service Purchased *</label>
                <input type="text" id="productName" name="productName" placeholder="e.g. Smart LED Television 55-inch" required>
              </div>
              <div class="form-group col-half">
                <label for="orderOrInvoiceNumber">Order ID / Invoice No *</label>
                <input type="text" id="orderOrInvoiceNumber" name="orderOrInvoiceNumber" placeholder="e.g. INV-9843217" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="orderDate">Date of Purchase</label>
                <input type="date" id="orderDate" name="orderDate">
              </div>
              <div class="form-group col-half">
                <label for="demandAmount">Amount Paid (₹) *</label>
                <input type="number" id="demandAmount" name="demandAmount" placeholder="e.g. 42000" required>
              </div>
            </div>

            <div class="form-group">
              <label for="defectDescription">Description of Defect / Grievance *</label>
              <textarea id="defectDescription" name="defectDescription" rows="4" placeholder="Detail the fault: e.g. The TV display stopped functioning within 10 days of delivery. Despite 3 service visits under warranty, technician refused repair and customer support closed ticket without resolution." required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="compensationAmount">Harassment Compensation Demand (₹)</label>
                <input type="number" id="compensationAmount" name="compensationAmount" value="10000">
              </div>
              <div class="form-group col-half">
                <label for="deadlineDays">Notice Compliance Period (Days)</label>
                <input type="number" id="deadlineDays" name="deadlineDays" value="15" min="7" max="30">
              </div>
            </div>
          <% } %>

          <!-- Police Complaint Form Fields -->
          <% if (selectedType === 'police-complaint') { %>
            <div class="form-group">
              <label for="complainantName">Complainant Full Name *</label>
              <input type="text" id="complainantName" name="complainantName" placeholder="e.g. Ajay Pratap Singh" required>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="parentOrSpouseName">Father's / Spouse's Name</label>
                <input type="text" id="parentOrSpouseName" name="parentOrSpouseName" placeholder="e.g. S/o Shri Vikram Singh">
              </div>
              <div class="form-group col-half">
                <label for="complainantPhone">Phone Number *</label>
                <input type="tel" id="complainantPhone" name="complainantPhone" placeholder="e.g. 9811223344" required>
              </div>
            </div>

            <div class="form-group">
              <label for="complainantAddress">Complainant Postal Address *</label>
              <textarea id="complainantAddress" name="complainantAddress" rows="2" placeholder="Full residential address" required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="policeStationName">Police Station Name *</label>
                <input type="text" id="policeStationName" name="policeStationName" placeholder="e.g. Sector-18 Police Station" required>
              </div>
              <div class="form-group col-half">
                <label for="policeStationAddress">City / District *</label>
                <input type="text" id="policeStationAddress" name="policeStationAddress" placeholder="e.g. Noida, Gautam Buddha Nagar, UP" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="dateOfIncident">Date & Time of Incident *</label>
                <input type="text" id="dateOfIncident" name="dateOfIncident" placeholder="e.g. 21st Nov 2026 at approx 07:30 PM" required>
              </div>
              <div class="form-group col-half">
                <label for="placeOfIncident">Exact Place of Incident *</label>
                <input type="text" id="placeOfIncident" name="placeOfIncident" placeholder="e.g. Outside Metro Station Gate No. 2" required>
              </div>
            </div>

            <div class="form-group">
              <label for="suspectDetails">Suspect Details (If known or vehicle numbers)</label>
              <input type="text" id="suspectDetails" name="suspectDetails" placeholder="e.g. Two unidentified persons on black motorcycle bearing partial number UP-16-XX">
            </div>

            <div class="form-group">
              <label for="incidentSummary">Chronological Narration of Incident *</label>
              <textarea id="incidentSummary" name="incidentSummary" rows="4" placeholder="Describe clearly what happened, who committed the offense, stolen property details, injuries, and witnesses present." required></textarea>
            </div>
          <% } %>

          <!-- Cheque Dishonour 138 Notice Fields -->
          <% if (selectedType === 'cheque-bounce-notice') { %>
            <div class="form-group">
              <label for="payeeName">Payee Name (You / Creditor) *</label>
              <input type="text" id="payeeName" name="payeeName" placeholder="e.g. Mukesh Chand" required>
            </div>

            <div class="form-group">
              <label for="payeeAddress">Payee Address *</label>
              <textarea id="payeeAddress" name="payeeAddress" rows="2" placeholder="Your complete address" required></textarea>
            </div>

            <div class="form-group">
              <label for="drawerName">Drawer Name (Accused / Debtor) *</label>
              <input type="text" id="drawerName" name="drawerName" placeholder="e.g. Vikas Mehra" required>
            </div>

            <div class="form-group">
              <label for="drawerAddress">Drawer Address *</label>
              <textarea id="drawerAddress" name="drawerAddress" rows="2" placeholder="Debtor's address where notice will be served" required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="chequeNumber">Cheque Number *</label>
                <input type="text" id="chequeNumber" name="chequeNumber" placeholder="e.g. 004512" required>
              </div>
              <div class="form-group col-half">
                <label for="chequeAmount">Cheque Amount (₹) *</label>
                <input type="number" id="chequeAmount" name="chequeAmount" placeholder="e.g. 150000" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="chequeDate">Cheque Date *</label>
                <input type="date" id="chequeDate" name="chequeDate" required>
              </div>
              <div class="form-group col-half">
                <label for="bankName">Bank & Branch *</label>
                <input type="text" id="bankName" name="bankName" placeholder="e.g. State Bank of India, Main Branch" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="dishonourDate">Bank Return Memo Date *</label>
                <input type="date" id="dishonourDate" name="dishonourDate" required>
              </div>
              <div class="form-group col-half">
                <label for="dishonourReason">Dishonour Reason</label>
                <select id="dishonourReason" name="dishonourReason">
                  <option value="Funds Insufficient">Funds Insufficient</option>
                  <option value="Account Closed">Account Closed</option>
                  <option value="Payment Stopped by Drawer">Payment Stopped by Drawer</option>
                  <option value="Signature Differs">Signature Differs</option>
                </select>
              </div>
            </div>
          <% } %>

          <div class="form-actions">
            <button type="submit" class="btn-primary btn-block" id="generateDraftBtn">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
              <span>Generate Formal Draft</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Right Column: Live Formatted Draft Output -->
      <div class="draft-preview-card">
        <div class="preview-header">
          <div class="preview-title">
            <i class="fa-solid fa-file-lines"></i>
            <h4>Live Legal Document Preview</h4>
          </div>
          <div class="preview-actions">
            <button type="button" class="btn-preview-action" id="copyDraftBtn" title="Copy to Clipboard">
              <i class="fa-solid fa-copy"></i> <span>Copy</span>
            </button>
            <button type="button" class="btn-preview-action" id="downloadDraftBtn" title="Download as Text File">
              <i class="fa-solid fa-download"></i> <span>Download</span>
            </button>
            <button type="button" class="btn-preview-action" id="printDraftBtn" title="Print Document">
              <i class="fa-solid fa-print"></i> <span>Print</span>
            </button>
          </div>
        </div>

        <div class="preview-body" id="draftPrintArea">
          <pre class="draft-output-text" id="draftOutputBox">Please complete the form on the left and click "Generate Formal Draft" to create your legally formatted notice or application.

All templates strictly adhere to statutory Indian legal drafting conventions (Section 6(1) RTI Act 2005, Section 35 Consumer Protection Act 2019, Section 173 BNSS 2023, and Section 138 NI Act).</pre>
        </div>

        <div class="preview-footer-note">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Send consumer & cheque notices via <strong>Registered Post A.D. or Speed Post</strong> to retain postal track proof.</span>
        </div>
      </div>
    </div>
  </section>
</main>

<script src="/js/drafts.js"></script>

<%- include('partials/footer') %>
